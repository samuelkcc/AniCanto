{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniCanto",
  "version": "0.24.48",
  "identifier": "com.sckc.cantosync.studio",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AniCanto",
        "width": 1500,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#F6F5F8",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
